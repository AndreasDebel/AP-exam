        <mxCell id="noteDemo" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" value="Til demoen er køberens pc, demo-pc&#39;en og Minikube den samme fysiske maskine (Minikube med Docker-driveren på Windows). k6 rammer API&#39;et via tunnelen fra &quot;minikube service api --url&quot;." vertex="1">
