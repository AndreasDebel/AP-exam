@using Microsoft.AspNetCore.Components.Web

<h1>@eventName</h1>
<p>@eventDate. Tickets left: @ticketsLeft</p>

@* @bind copies the textbox into attendeeName every time the text changes *@
<input @bind="attendeeName" @bind:event="oninput" placeholder="Your name" />

@* @onclick runs BookTicket() each time the visitor clicks the button *@
<button @onclick="BookTicket">Book ticket</button>

@if (bookedName != "")
{
    <p>Booked: @bookedName</p>
}

@code {
    string eventName = "Spring Concert";
    string eventDate = "2027-05-20";
    int ticketsLeft = 50;

    string attendeeName = "";
    string bookedName = "";

    void BookTicket()
    {
        // TODO: replace these three lines with a call to the API (next ticket).
        // Skipped on purpose: no check for an empty name or for tickets running out.
        ticketsLeft = ticketsLeft - 1;
        bookedName = attendeeName;
        attendeeName = "";
    }
}
