        <mxCell id="noteRouter" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" value="Ingen egen klasse i koden: en Dictionary&amp;lt;string, string&amp;gt; læst fra Sections__1..4 (k8s/api.yaml).&lt;div&gt;Kvalifikatoren sectionId vælger præcis én database.&lt;/div&gt;&lt;div&gt;Flyt en sektion = ret config, ikke kode.&lt;/div&gt;" vertex="1">
          <mxGeometry height="76" width="300" x="740" y="894" as="geometry" />
        </mxCell>
        <mxCell id="noteSection" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" value="Ingen C#-klasse: rækker i tabellen section (k8s/schema.yaml). API&#39;et bruger den med SQL.&lt;div&gt;disabled = true: sektionen afviser køb (kill switch).&lt;/div&gt;&lt;div&gt;{sold &amp;lt;= capacity} håndhæves af API&#39;et (rækkelås + tjek), ikke af databasen: schemaet har ingen CHECK.&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="290" x="1390" y="603" as="geometry" />
        </mxCell>
        <mxCell id="noteProgram" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" value="cacheEnabled, redis og router er lokale variabler i top-level statements, som endpoint-lambdaerne fanger, ikke felter. Endpoints er vist som operationer (pragmatisk)." vertex="1">
          <mxGeometry height="60" width="310" x="525" y="180" as="geometry" />
        </mxCell>
        <mxCell id="noteDatabase" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" value="Én instans pr. connection string I routeren.&lt;div&gt;Hver instans har alle sektionsrækkerne (samme schema.sql); routeren afgør, hvilke der er &quot;live&quot; i hver.&lt;/div&gt;" vertex="1">
          <mxGeometry height="76" width="300" x="1068" y="894" as="geometry" />
        </mxCell>
        <mxCell id="noteCache" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" value="Kopi af free i Redis, udløber efter 2 s.&lt;br&gt;Kan være forældet. Bruges kun når&lt;br&gt;cacheEnabled; /buy læser aldrig cachen." vertex="1">
          <mxGeometry height="60" width="250" x="1390" y="428" as="geometry" />
        </mxCell>
        <mxCell id="noteHttp" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" value="UI&#39;et kalder API&#39;et over netværket via&lt;br&gt;nginx i ui-poden:&lt;br&gt;GET /sections/{id}, POST /sections/{id}/buy" vertex="1">
          <mxGeometry height="60" width="280" x="200" y="180" as="geometry" />
